{
  "name": "@sqaft/updeps-gui",
  "version": "0.0.2",
  "description": "Desktop app for updeps: edit the dependency graph and see the daemon's status and failures in the system tray. macOS, Linux and Windows.",
  "keywords": [
    "updeps",
    "dependencies",
    "dependency-graph",
    "polyrepo",
    "multi-repo",
    "tray",
    "electron",
    "desktop"
  ],
  "homepage": "https://github.com/sqaft/sqaft-updeps-gui#readme",
  "bugs": {
    "url": "https://github.com/sqaft/sqaft-updeps-gui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sqaft/sqaft-updeps-gui.git"
  },
  "author": "sqaft",
  "license": "MIT",
  "type": "module",
  "main": "src/main/main.js",
  "bin": {
    "updeps-gui": "bin/updeps-gui.js"
  },
  "files": [
    "bin/",
    "src/",
    "assets/"
  ],
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "icons": "node scripts/icons.js",
    "screenshots": "electron scripts/screenshots.js",
    "screenshots:demo": "node scripts/demo.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "electron": "^44.10.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
